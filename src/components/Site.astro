---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/global.css';
import type { SiteConfig } from '../config/types.ts';
import { validateConfig } from '../lib/validate.ts';
import { contactLink } from '../lib/business.ts';
import Hero from './Hero.astro';
import Services from './Services.astro';
import Promotions from './Promotions.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
interface Props {
  config: SiteConfig;
}
const { config } = Astro.props;
validateConfig(config);
const sections = config.sections.filter((s) => s.visible);
const components = {
  inicio: Hero,
  servicios: Services,
  promociones: Promotions,
  contacto: Contact,
};
const home = sections[0] ? `#${sections[0].id}` : '#main';
const fontDisplay = {
  editorial: "'Cormorant Garamond', Georgia, serif",
  classic: 'Georgia, serif',
  sans: "'DM Sans', system-ui, sans-serif",
};
const fontBody = {
  'dm-sans': "'DM Sans', system-ui, sans-serif",
  system: 'system-ui, sans-serif',
};
const themeStyle =
  Object.entries(config.theme)
    .map(([key, value]) => `--${key}: ${value}`)
    .join(';') +
  `; --font-display: ${fontDisplay[config.typography.display]}; --font-body: ${fontBody[config.typography.body]}`;
const openingHoursSpecification = config.schedule.weekly.flatMap((day) =>
  day.intervals.map(([opens, closes]) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: [
      'Sunday',
      'Monday',
      'Tuesday',
      'Wednesday',
      'Thursday',
      'Friday',
      'Saturday',
    ][day.day],
    opens,
    closes,
  })),
);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HairSalon',
  '@id': `${config.siteUrl}/#business`,
  name: config.business.name,
  url: config.siteUrl,
  description: config.seo.description,
  image: new URL(config.seo.shareImage, config.siteUrl).href,
  telephone: config.business.phone,
  priceRange: '$$',
  currenciesAccepted: 'MXN',
  address: {
    '@type': 'PostalAddress',
    streetAddress: config.business.address,
    addressLocality: config.business.locality,
    addressRegion: config.business.region,
    postalCode: config.business.postalCode,
    addressCountry: config.business.country,
  },
  openingHoursSpecification,
  specialOpeningHoursSpecification: config.schedule.exceptions.flatMap(
    (exception) =>
      (exception.intervals.length
        ? exception.intervals
        : [['00:00', '00:00']]
      ).map(([opens, closes]) => ({
        '@type': 'OpeningHoursSpecification',
        validFrom: exception.date,
        validThrough: exception.date,
        opens,
        closes,
      })),
  ),
};
const safeJSON = (value: unknown) =>
  JSON.stringify(value)
    .replace(/</g, '\\u003c')
    .replace(/\u2028/g, '\\u2028')
    .replace(/\u2029/g, '\\u2029');
// Solo la demostración incluye ruta alternativa; al pasar demo a false desaparece también del build.
const otherDemo = config.id === 'bruma' ? '/ejemplos/olivo/' : '/';
---

<!doctype html>
<html lang="es-MX" style={themeStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content={config.theme.background} />
    <title>{config.seo.title}</title>
    <meta name="description" content={config.seo.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`${config.siteUrl}/`} />
    {config.demo && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:title" content={config.seo.title} />
    <meta property="og:description" content={config.seo.description} />
    <meta property="og:url" content={`${config.siteUrl}/`} />
    <meta
      property="og:image"
      content={new URL(config.seo.shareImage, config.siteUrl).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${config.business.name} · ${config.business.tagline}`}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={safeJSON(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Saltar al contenido
    </a>
    {config.demo && (
      <aside class="demo-bar" aria-label="Información de demostración">
        <span>
          PLANTILLA EN DEMOSTRACIÓN{' '}
          <span class="demo-bar__detail">· Negocio y datos ficticios</span>
        </span>
        <a href={otherDemo}>
          Ver otra configuración <span aria-hidden="true">↗</span>
        </a>
      </aside>
    )}
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={home} aria-label={config.business.name}>
          <span class="brand__mark">
            {config.business.logo ? (
              <img src={config.business.logo} alt="" width="28" height="28" />
            ) : (
              <Icon name="scissors" size={25} />
            )}
          </span>
          <span>
            <span class="brand__name">{config.business.shortName}</span>
            <span class="brand__tagline">{config.business.tagline}</span>
          </span>
        </a>
        <button
          type="button"
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="main-nav"
          aria-label="Abrir menú"
          data-menu-toggle
          hidden
        >
          <span></span>
          <span></span>
        </button>
        <nav id="main-nav" class="main-nav" aria-label="Navegación principal">
          {sections.map((section) => (
            <a href={`#${section.id}`}>{section.label}</a>
          ))}
        </nav>
        <a
          class="header-contact"
          href={contactLink(config)}
          data-contact
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" size={18} /> Solicitar cita{' '}
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main" class="container">
      {!sections.some((section) => section.id === 'inicio') && (
        <h1 class="sr-only">{config.business.name}</h1>
      )}
      {sections.map((section) => {
        const Component = components[section.id];
        return <Component config={config} />;
      })}
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-brand" href={home}>
          {config.business.shortName}
          <span>BARBERÍA & CUIDADO</span>
        </a>
        <nav aria-label="Navegación del pie">
          {sections.map((section) => (
            <a href={`#${section.id}`}>{section.label}</a>
          ))}
        </nav>
        <a href={`tel:${config.business.phone}`} data-phone>
          {config.business.phoneDisplay}
        </a>
        <p>
          © <span data-current-year>{new Date().getFullYear()}</span>{' '}
          {config.business.name}.
        </p>
      </div>
      {config.demo && (
        <p class="demo-footer">
          Demostración · Dirección y teléfono ficticios · Fotografías generadas
          con IA
        </p>
      )}
    </footer>
    <a
      class="whatsapp-float"
      href={contactLink(config)}
      data-contact
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Solicitar cita por WhatsApp"
    >
      <Icon name="whatsapp" size={25} />
      <span>¿Agendamos?</span>
    </a>
    <dialog
      class="contact-dialog"
      data-contact-dialog
      aria-labelledby="dialog-title"
    >
      <button
        class="dialog-close"
        type="button"
        data-close-dialog
        aria-label="Cerrar demostración"
      >
        ×
      </button>
      <span class="eyebrow">VISTA PREVIA DEL CONTACTO</span>
      <h2 id="dialog-title">
        Así empieza
        <br />
        <em>la conversación.</em>
      </h2>
      <p>
        Esta es una barbería ficticia. En un proyecto real, el botón abrirá
        WhatsApp con este mensaje:
      </p>
      <blockquote data-message-preview></blockquote>
      <p class="closed-note" data-dialog-closed hidden>
        {config.business.closedMessage}
      </p>
      <button type="button" class="button button--primary" data-close-dialog>
        Entendido <Icon name="check" size={18} />
      </button>
    </dialog>
    <script
      type="application/json"
      id="site-config"
      set:html={safeJSON(config)}
    />
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
